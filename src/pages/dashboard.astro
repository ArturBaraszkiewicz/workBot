---
import Layout from "@/layouts/Layout.astro";

const { panelAccess, user } = Astro.locals;

if (panelAccess.kind !== "granted") {
  return Astro.redirect("/auth/signin");
}

const roleLabel = panelAccess.principal.role === "hr_admin" ? "HR / Administrator" : "Project Manager";
---

<Layout title="Panel workBot">
  <main class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <section class="w-full max-w-xl rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <p class="mb-2 text-sm font-medium tracking-wide text-purple-200 uppercase">workBot</p>
      <h1 class="mb-5 text-3xl font-bold">Panel administracyjny</h1>

      <dl class="grid gap-4 rounded-xl border border-white/10 bg-black/10 p-5 sm:grid-cols-2">
        <div>
          <dt class="text-xs tracking-wide text-blue-100/50 uppercase">Konto</dt>
          <dd class="mt-1 font-medium break-all">{user?.email ?? panelAccess.principal.userId}</dd>
        </div>
        <div>
          <dt class="text-xs tracking-wide text-blue-100/50 uppercase">Rola panelowa</dt>
          <dd class="mt-1 font-medium">{roleLabel}</dd>
        </div>
      </dl>

      <p class="mt-5 text-sm leading-6 text-blue-100/65">
        Fundament dostępu jest aktywny. Moduły zespołów, pracowników i statystyk pojawią się w kolejnych etapach.
      </p>

      <div class="mt-7 flex flex-wrap gap-4">
        <a href="/" class="rounded-lg border border-white/20 px-4 py-2 text-sm hover:bg-white/10">Strona główna</a>
        <form method="POST" action="/api/auth/signout">
          <button type="submit" class="rounded-lg bg-purple-600 px-4 py-2 text-sm font-medium hover:bg-purple-500">
            Wyloguj się
          </button>
        </form>
      </div>
    </section>
  </main>
</Layout>
