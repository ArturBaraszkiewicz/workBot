---
const { panelAccess, user } = Astro.locals;
---

<header
  class="mb-4 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-white/80"
>
  <a href="/" class="font-semibold text-white hover:text-purple-100">workBot</a>

  {
    panelAccess.kind === "granted" ? (
      <div class="flex flex-wrap items-center gap-3">
        <span class="max-w-56 truncate text-blue-100/70">{user?.email}</span>
        <a href="/dashboard" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
          Panel
        </a>
        <form method="POST" action="/api/auth/signout">
          <button type="submit" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            Wyloguj
          </button>
        </form>
      </div>
    ) : panelAccess.kind === "denied" ? (
      <div class="flex flex-wrap items-center gap-3">
        <span class="text-amber-200">Brak aktywnego dostępu do panelu</span>
        <form method="POST" action="/api/auth/signout">
          <button type="submit" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            Wyloguj
          </button>
        </form>
      </div>
    ) : panelAccess.kind === "unavailable" ? (
      <div class="flex flex-wrap items-center gap-3">
        <span class="text-amber-200">Dostęp chwilowo nieweryfikowalny</span>
        <form method="POST" action="/api/auth/signout">
          <button type="submit" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            Wyloguj
          </button>
        </form>
      </div>
    ) : (
      <a href="/auth/signin" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
        Zaloguj przez Google
      </a>
    )
  }
</header>
